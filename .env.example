# Postgres (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Prisma / apps/api
DATABASE_URL=""

# Isolated database for apps/api e2e tests — must point at a different
# database name than DATABASE_URL. e2e specs delete/reset tables freely, so
# this must never point at the same database as local dev data.
DATABASE_URL_TEST=""

# apps/api
PORT=4000
CORS_ORIGIN=http://localhost:3000
